@page "/settings"
@inject IStringLocalizer<Index> localizer

<div style="padding: 20px; overflow-x: auto; overflow-y: scroll; height: 100%; ">

    <h3>@localizer["settings.title.settings"]</h3>

    <PrinterQueueDialog @ref="PrinterDialog" />
    <CapturedImageDialog @ref="ImageDialog" />
    
    <MudStack Spacing="4" Style="margin:20px; max-width: 400px;">

        <MudSelect T="string" Label=@localizer["settings.selected_language"] @bind-Value="SelectedLanguage">
            @foreach (var langCode in langCodes)
            {
                <MudSelectItem T="string" Value="@langCode.IsoCode">@langCode.Name</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string" Label=@localizer["settings.selected_camera"] Value=@SelectedCamera Disabled="true" />

        <MudTextField T="string" Label=@localizer["settings.selected_printer"] Value=@SelectedPrinter Disabled="true" />

        <div>
            <MudText Typo="Typo.caption">@localizer["settings.printer_queue"]</MudText>
            <p><MudLink Href=@PrintServerUrl Target="_blank">Cups-Print-Server</MudLink></p>
        </div>

        <div>
            <MudText Typo="Typo.caption">@localizer["settings.captured_images"]</MudText>
            <p>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ShowAvailableImages">@localizer["settings.show_captured_images"]</MudButton>
            </p>
        </div>

        <MudNumericField T="int" Label=@localizer["settings.review_count_down_step_count"] @bind-Value="ReviewCountDownStepCount" />

        <MudNumericField T="int" Label=@localizer["settings.capture_count_down_step_count"] @bind-Value="CaptureCountDownStepCount" />

        <MudNumericField T="double" Label=@localizer["settings.step_duration_in_seconds"] @bind-Value="StepDownDurationInSeconds" />

        <MudNumericField T="int" Label=@localizer["settings.review_image_width"] @bind-Value="ReviewImageWidth" />

        <MudNumericField T="int" Label=@localizer["settings.review_image_quality"] @bind-Value="ReviewImageQuality" />

        <MudCheckBox T="bool" Label=@localizer["settings.blinking_enabled"] @bind-Value="BlinkingEnabled" />

        <div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettings">@localizer["settings.save_settings"]</MudButton>
        </div>

    </MudStack>


</div>


