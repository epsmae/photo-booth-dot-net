@inject IStringLocalizer<PhotoBooth.Client.Pages.Index> localizer

@if (ShowDialog)
{
    <div class="modal fade show d-block" id="exampleModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">@localizer["printer_queue_dialog.printer_queue"]</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                            @onclick="() => OnCloseDialog()">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="overflow: hidden;">

                    <div style="max-height: 200px; overflow-y: auto;">
                        @foreach (var item in PrinterQueue)
                        {
                            <p>
                                @item.Name<br />
                            </p>
                        }
                    </div>
                </div>
                <div class="modal-footer">

                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2" OnClick="() => ClearPrinterQueue()">
                        @localizer["printer_queue_dialog.clear_queue"]
                    </MudButton>


                    <MudButton Variant="Variant.Filled" Color="Color.Error" Class="ml-2" OnClick="() => OnCloseDialog()">
                        @localizer["printer_queue_dialog.ok"]
                    </MudButton>
                </div>
            </div>
        </div>
    </div>
}