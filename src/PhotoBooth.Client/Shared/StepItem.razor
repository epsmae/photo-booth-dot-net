@inject IStringLocalizer<Index> localizer




<div Class="step_container" style="width: 100%;">

    <div style="width: 100%; display: flex; flex-direction: column;">

        <div Class="header_container" style="width: 100%;">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Filled" Color="Color.Secondary" OnClick="GoToPreviousStep" Disabled="@IsPreviousDisabled" />
            <p>@Header</p>
            <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToNextStep" Disabled="@IsNextDisabled" />
        </div>

        <div>

            <MudAlert Severity="Severity.Success">
                <b>@Title</b> @Description
            </MudAlert>
        </div>

        <div Elevation="0" Style="width: 100%; display: flex; flex-grow: 1; justify-content: center; align-items: stretch;">
            <div Class="d-flex" Style="width: 80%; height:100%; margin: auto;">
                @ChildContent
            </div>

        </div>
    </div>
</div>