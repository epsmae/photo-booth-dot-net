{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:5050"
      }
    }
  },
  "AllowedHosts": "*",
  "Camera": {
    "Driver": "LibGPhoto2",
    "Simulate": null,
    "FocusMode": "None",
    "CaptureTarget": "Memory card",
    "LiveViewHoldSeconds": 60,
    "MaxPreviewErrors": 5
  },
  "LiveView": {
    "Enabled": true,
    "Source": "",
    "Mirror": true,
    "IdleTimeoutSeconds": 300,
    "StopTimeoutMilliseconds": 5000,
    "Camera": "",
    "GPhoto2Path": "gphoto2"
  }
}
